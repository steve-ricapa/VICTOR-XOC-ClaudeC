# =============================================================================
# Victor On-Premise - XOC APPLIANCE Configuration
# =============================================================================
# Copy this file to .env and fill in the values before deploying.

# --- LLM Provider (Required) ---
# Anthropic API key for Claude
ANTHROPIC_API_KEY=replace_with_real_key
# Model to use (default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Azure Endpoint (Optional, overrides Anthropic direct) ---
# If using Azure-hosted Claude endpoint instead of Anthropic direct:
# AZURE_ENDPOINT=https://aoai-sophia-xoc-eus2.services.ai.azure.com/anthropic
# AZURE_DEPLOYMENT=claude-sonnet-4-6

# --- Executor ---
# Internal executor URL (docker-compose uses http://executor:8888)
# Only change if running executor separately
EXECUTOR_URL=http://executor:8888

# --- Server ---
PORT=8000

# --- Stage ---
# dev | staging | prod
STAGE=prod

# --- DynamoDB (for ticket status updates) ---
# Only needed if victor_server.py updates DynamoDB directly
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
